  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "inboundTag": [
          "kddi-reality"
        ],
        "network": "udp",
        "outboundTag": "blocked"
      },
      {
        "type": "field",
        "inboundTag": [
